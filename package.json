{
  "name": "my-monokai",
  "displayName": "My Monokai Dimmed",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "dimmed",
    "dark",
    "semantic highlighting",
    "theme"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "My Monokai Dimmed",
        "label": "My Monokai Dimmed",
        "uiTheme": "vs-dark",
        "path": "./themes/my-monokai-dimmed-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.js",
    "verify": "node build.js && node scripts/verify.js",
    "link": "ln -sfn \"$PWD\" \"$HOME/.vscode/extensions/my-monokai\" && echo linked",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "install-local": "npm run package && code --install-extension my-monokai-1.0.0.vsix --force",
    "tokens": "node scripts/tokens.js"
  }
}
