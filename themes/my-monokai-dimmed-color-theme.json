{
  "$schema": "vscode://schemas/color-theme",
  "name": "My Monokai Dimmed",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#282D33",
    "list.activeSelectionBackground": "#39434D",
    "quickInputList.focusBackground": "#39434D",
    "list.inactiveSelectionBackground": "#353B42",
    "list.hoverBackground": "#30353B",
    "list.highlightForeground": "#D9A65A",
    "button.background": "#35404A",
    "editor.background": "#1B1D1F",
    "editor.foreground": "#C6C9C7",
    "editor.selectionBackground": "#5B647080",
    "minimap.selectionHighlight": "#5B647080",
    "editor.selectionHighlightBackground": "#46505A80",
    "editor.lineHighlightBackground": "#2C3036",
    "editorLineNumber.activeForeground": "#8E949B",
    "editor.wordHighlightBackground": "#3D536D80",
    "editor.wordHighlightStrongBackground": "#526F8B80",
    "editorCursor.foreground": "#D29A5E",
    "editorWhitespace.foreground": "#3C4741",
    "editorIndentGuide.background1": "#3C4741",
    "editorIndentGuide.activeBackground1": "#59675F",
    "editorGroupHeader.tabsBackground": "#22252A",
    "tab.inactiveBackground": "#282C31",
    "tab.border": "#2C3036",
    "tab.inactiveForeground": "#D5D8DB",
    "tab.lastPinnedBorder": "#25292E",
    "peekView.border": "#5F8FA3",
    "panelTitle.activeForeground": "#F4F6F8",
    "statusBar.background": "#25292E",
    "statusBar.debuggingBackground": "#25292E",
    "statusBar.noFolderBackground": "#25292E",
    "titleBar.activeBackground": "#25292E",
    "statusBarItem.remoteBackground": "#5F8FA3",
    "ports.iconRunningProcessForeground": "#C6C9CD",
    "activityBar.background": "#24272C",
    "activityBar.foreground": "#F4F6F8",
    "activityBarBadge.background": "#5F8FA3",
    "sideBar.background": "#202327",
    "sideBarSectionHeader.background": "#25292E",
    "menu.background": "#202327",
    "menu.foreground": "#C6C9CD",
    "pickerGroup.foreground": "#AAB0B6",
    "inputOption.activeBorder": "#5F8FA3",
    "focusBorder": "#5F8FA3",
    "agentsPanel.border": "#2C3036",
    "agentsChatInput.border": "#2C3036",
    "agentsChatInput.focusBorder": "#5F8FA3",
    "agentsNewSessionButton.border": "#2C3036",
    "terminal.ansiBlack": "#1B1D1F",
    "terminal.ansiRed": "#C95F6A",
    "terminal.ansiGreen": "#86A966",
    "terminal.ansiYellow": "#C4A95D",
    "terminal.ansiBlue": "#6E8FB2",
    "terminal.ansiMagenta": "#A07CB0",
    "terminal.ansiCyan": "#64A6AE",
    "terminal.ansiWhite": "#D7D9D7",
    "terminal.ansiBrightBlack": "#5C636A",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#A5C77A",
    "terminal.ansiBrightYellow": "#E1C56B",
    "terminal.ansiBrightBlue": "#88A9D0",
    "terminal.ansiBrightMagenta": "#AE91E8",
    "terminal.ansiBrightCyan": "#7CC7D1",
    "terminal.ansiBrightWhite": "#F1F3F1",
    "terminal.inactiveSelectionBackground": "#5B647040",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#B08DB4",
    "type": "#8EB86B",
    "class": "#8EB86B",
    "enum": "#8EB86B",
    "interface": "#8EB86B",
    "struct": "#8EB86B",
    "typeParameter": "#70BFA7",
    "parameter": "#7F9FBE",
    "variable": "#C6C9C7",
    "variable.readonly": "#8E8FE1",
    "variable.defaultLibrary": "#D76767",
    "property": "#B08DB4",
    "property.readonly": "#8E8FE1",
    "enumMember": "#8E8FE1",
    "event": "#B08DB4",
    "function": "#78B9C6",
    "function.defaultLibrary": "#B08DB4",
    "method": "#78B9C6",
    "method.defaultLibrary": "#B08DB4",
    "macro": "#D28B58",
    "label": "#D9B85F",
    "decorator": "#68AAA5",
    "selfParameter": "#D592CF",
    "builtinConstant": "#70BFA7",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#70BFA7",
    "variable.readonly:go": "#8E8FE1",
    "selfParameter:python": "#D592CF",
    "clsParameter:python": "#D592CF",
    "magicFunction:python": "#B08DB4",
    "builtinConstant:python": "#70BFA7",
    "module:python": "#B08DB4",
    "variable.defaultLibrary:typescript": "#D76767",
    "variable.defaultLibrary:javascript": "#D76767",
    "lifetime:rust": "#D28B58",
    "builtinType:rust": "#70BFA7",
    "decorator:python": "#68AAA5",
    "function.decorator": "#68AAA5",
    "method.decorator": "#68AAA5",
    "class.decorator": "#68AAA5",
    "function.decorator:python": "#68AAA5",
    "class.decorator:python": "#68AAA5"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#C6C9C7"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#C6C9C7"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#8D918A"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#A7B970"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#D28B58"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#70BFA7"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#8E8FE1"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#D76767"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#8EB86B"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#D76767"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#78B9C6"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#9EAEC0"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#FF5F56"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#A7B970"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#A7B970"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#A7B970"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#A7B970"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#949894"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#D76767"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#D76767"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#D28B58"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#C6C9C7"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#A7B970"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#949894"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#D28B58"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#A7B970"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#D9B85F"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#D28B58"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D9E2D4"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#D76767"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#D28B58"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#70BFA7"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#A7B970"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#7F9FBE"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#E66A9E"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#D6B75C"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#AE91E8"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#7F9FBE"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#D6A95C"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#B08DB4"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#D76767"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#D592CF"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#68AAA5"
      }
    }
  ]
}
