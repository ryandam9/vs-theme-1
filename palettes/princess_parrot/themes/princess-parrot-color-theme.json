{
  "$schema": "vscode://schemas/color-theme",
  "name": "Princess Parrot",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#4a5647",
    "list.activeSelectionBackground": "#687465",
    "quickInputList.focusBackground": "#687465",
    "list.inactiveSelectionBackground": "#465244",
    "list.hoverBackground": "#3c483a",
    "list.highlightForeground": "#d48f45",
    "button.background": "#4e5a4b",
    "editor.background": "#172115",
    "editor.foreground": "#c3cac1",
    "editor.selectionBackground": "#576b8e80",
    "minimap.selectionHighlight": "#576b8e80",
    "editor.selectionHighlightBackground": "#485b7d80",
    "editor.lineHighlightBackground": "#293426",
    "editorLineNumber.activeForeground": "#90968e",
    "editor.wordHighlightBackground": "#30539380",
    "editor.wordHighlightStrongBackground": "#4e75bb80",
    "editorCursor.foreground": "#b67730",
    "editorWhitespace.foreground": "#515123",
    "editorIndentGuide.background1": "#515123",
    "editorIndentGuide.activeBackground1": "#717143",
    "editorGroupHeader.tabsBackground": "#212c1e",
    "tab.inactiveBackground": "#384436",
    "tab.border": "#293426",
    "tab.inactiveForeground": "#d4dbd2",
    "tab.lastPinnedBorder": "#485445",
    "peekView.border": "#395c9d",
    "panelTitle.activeForeground": "#ffffff",
    "statusBar.background": "#485445",
    "statusBar.debuggingBackground": "#485445",
    "statusBar.noFolderBackground": "#485445",
    "titleBar.activeBackground": "#485445",
    "statusBarItem.remoteBackground": "#395c9d",
    "ports.iconRunningProcessForeground": "#c8cfc6",
    "activityBar.background": "#2e392b",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#395c9d",
    "sideBar.background": "#202b1d",
    "sideBarSectionHeader.background": "#485445",
    "menu.background": "#202b1d",
    "menu.foreground": "#c8cfc6",
    "pickerGroup.foreground": "#acb2aa",
    "inputOption.activeBorder": "#395c9d",
    "focusBorder": "#395c9d",
    "agentsPanel.border": "#293426",
    "agentsChatInput.border": "#293426",
    "agentsChatInput.focusBorder": "#395c9d",
    "agentsNewSessionButton.border": "#293426",
    "terminal.ansiBlack": "#172115",
    "terminal.ansiRed": "#d2355f",
    "terminal.ansiGreen": "#85b42c",
    "terminal.ansiYellow": "#b4b42a",
    "terminal.ansiBlue": "#677fc8",
    "terminal.ansiMagenta": "#8e6ac7",
    "terminal.ansiCyan": "#5babc4",
    "terminal.ansiWhite": "#e3e3dd",
    "terminal.ansiBrightBlack": "#5e6a5b",
    "terminal.ansiBrightRed": "#fb2567",
    "terminal.ansiBrightGreen": "#a5e230",
    "terminal.ansiBrightYellow": "#e3e22d",
    "terminal.ansiBrightBlue": "#7c9cff",
    "terminal.ansiBrightMagenta": "#dcbeff",
    "terminal.ansiBrightCyan": "#6dd6f8",
    "terminal.ansiBrightWhite": "#f8f8f2",
    "terminal.inactiveSelectionBackground": "#576b8e40",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#b799db",
    "type": "#7ec058",
    "class": "#7ec058",
    "enum": "#7ec058",
    "interface": "#7ec058",
    "struct": "#7ec058",
    "typeParameter": "#afe0a4",
    "parameter": "#749bc5",
    "variable": "#c3cac1",
    "variable.readonly": "#6a92d9",
    "variable.defaultLibrary": "#ff6366",
    "property": "#b799db",
    "property.readonly": "#6a92d9",
    "enumMember": "#6a92d9",
    "event": "#b799db",
    "function": "#9ecbfc",
    "function.defaultLibrary": "#b799db",
    "method": "#9ecbfc",
    "method.defaultLibrary": "#b799db",
    "macro": "#d49453",
    "label": "#e0e08e",
    "decorator": "#7ca772",
    "selfParameter": "#e9d8ff",
    "builtinConstant": "#afe0a4",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#afe0a4",
    "variable.readonly:go": "#6a92d9",
    "selfParameter:python": "#e9d8ff",
    "clsParameter:python": "#e9d8ff",
    "magicFunction:python": "#b799db",
    "builtinConstant:python": "#afe0a4",
    "module:python": "#b799db",
    "variable.defaultLibrary:typescript": "#ff8987",
    "variable.defaultLibrary:javascript": "#ff8987",
    "lifetime:rust": "#d49453",
    "builtinType:rust": "#afe0a4",
    "decorator:python": "#7ca772",
    "function.decorator": "#7ca772",
    "method.decorator": "#7ca772",
    "class.decorator": "#7ca772",
    "function.decorator:python": "#7ca772",
    "class.decorator:python": "#7ca772"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#c3cac1"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#c3cac1"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#b78756"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d49453"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#749bc5"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#afe0a4"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#6a92d9"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff6366"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#b799db"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#7ec058"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#ff6366"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#9ecbfc"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#749bc5"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#b799db"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#8bacd2"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#749bc5"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff0b00"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#749bc5"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#b799db"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#b799db"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#caabee"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#749bc5"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#b799db"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#749bc5"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#749bc5"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#b799db"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#64835c"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff6366"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#ff8987"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#d49453"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#c3cac1"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#64835c"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#d49453"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#e0e08e"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#d49453"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#e03733"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b799db"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#b1c69b"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#749bc5"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#ce639d"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#cdcd82"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#dcbeff"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#ff6366"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#e9d8ff"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#7ca772"
      }
    }
  ]
}
