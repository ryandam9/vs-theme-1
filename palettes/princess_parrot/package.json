{
  "name": "princess-parrot",
  "displayName": "Princess Parrot",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Princess Parrot palette.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "dark",
    "semantic highlighting",
    "theme",
    "Princess Parrot"
  ],
  "galleryBanner": {
    "color": "#172115",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Princess Parrot",
        "label": "Princess Parrot",
        "uiTheme": "vs-dark",
        "path": "./themes/princess-parrot-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js princess_parrot",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && code --install-extension princess-parrot-1.0.0.vsix --force"
  }
}
