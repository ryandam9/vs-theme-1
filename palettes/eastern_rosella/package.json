{
  "name": "eastern-rosella",
  "displayName": "Eastern Rosella",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Eastern Rosella palette.",
  "version": "1.0.13",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "dark",
    "semantic highlighting",
    "theme",
    "Eastern Rosella"
  ],
  "galleryBanner": {
    "color": "#10181E",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Eastern Rosella",
        "label": "Eastern Rosella",
        "uiTheme": "vs-dark",
        "path": "./themes/eastern-rosella-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js eastern_rosella",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && node ../../scripts/install-local.js"
  }
}
