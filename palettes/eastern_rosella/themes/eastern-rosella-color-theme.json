{
  "$schema": "vscode://schemas/color-theme",
  "name": "Eastern Rosella",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#213126",
    "list.activeSelectionBackground": "#1f533c",
    "quickInputList.focusBackground": "#36463b",
    "list.inactiveSelectionBackground": "#2f3f34",
    "list.hoverBackground": "#b8c9dc",
    "list.highlightForeground": "#e49f64",
    "button.background": "#334338",
    "editor.background": "#10181E",
    "editor.foreground": "#c2cbc5",
    "editor.selectionBackground": "#58657380",
    "minimap.selectionHighlight": "#58657380",
    "editor.selectionHighlightBackground": "#25527980",
    "editor.lineHighlightBackground": "#24342a",
    "editorLineNumber.activeForeground": "#8e9690",
    "editor.wordHighlightBackground": "#41536780",
    "editor.wordHighlightStrongBackground": "#3a70a080",
    "editorCursor.foreground": "#d9965d",
    "editorWhitespace.foreground": "#324b3a",
    "editorIndentGuide.background1": "#324b3a",
    "editorIndentGuide.activeBackground1": "#506b58",
    "editorGroupHeader.tabsBackground": "#2f7ab9",
    "tab.inactiveBackground": "#2f533c",
    "tab.border": "#f4c623",
    "tab.inactiveForeground": "#d2dad4",
    "tab.lastPinnedBorder": "#2A3942",
    "peekView.border": "#508cc2",
    "panelTitle.activeForeground": "#f0f8f2",
    "statusBar.background": "#2A3942",
    "statusBar.debuggingBackground": "#2A3942",
    "statusBar.noFolderBackground": "#2A3942",
    "titleBar.activeBackground": "#2A3942",
    "statusBarItem.remoteBackground": "#508cc2",
    "ports.iconRunningProcessForeground": "#c3cbc5",
    "activityBar.background": "#151F26",
    "activityBar.foreground": "#f0f8f2",
    "activityBarBadge.background": "#508cc2",
    "sideBar.background": "#10181E",
    "sideBarSectionHeader.background": "#4f533c",
    "menu.background": "#182229",
    "menu.foreground": "#c3cbc5",
    "pickerGroup.foreground": "#a9b2ac",
    "inputOption.activeBorder": "#508cc2",
    "focusBorder": "#508cc2",
    "agentsPanel.border": "#24342a",
    "agentsChatInput.border": "#24342a",
    "agentsChatInput.focusBorder": "#508cc2",
    "agentsNewSessionButton.border": "#24342a",
    "terminal.ansiBlack": "#10181E",
    "terminal.ansiRed": "#c95f64",
    "terminal.ansiGreen": "#88a965",
    "terminal.ansiYellow": "#c4a95d",
    "terminal.ansiBlue": "#6e8fb2",
    "terminal.ansiMagenta": "#9b7eb4",
    "terminal.ansiCyan": "#64a6ad",
    "terminal.ansiWhite": "#d7d9d7",
    "terminal.ansiBrightBlack": "#56675b",
    "terminal.ansiBrightRed": "#e06d6f",
    "terminal.ansiBrightGreen": "#a6c779",
    "terminal.ansiBrightYellow": "#e1c56b",
    "terminal.ansiBrightBlue": "#88a9d0",
    "terminal.ansiBrightMagenta": "#d8d6ff",
    "terminal.ansiBrightCyan": "#7cc7d0",
    "terminal.ansiBrightWhite": "#f1f3f1",
    "terminal.inactiveSelectionBackground": "#58657340",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000",
    "titleBar.inactiveBackground": "#141C22",
    "titleBar.border": "#2A3942",
    "editorGroupHeader.noTabsBackground": "#151F26",
    "editorGroupHeader.tabsBorder": "#2A3942",
    "editorGroup.border": "#2A3942",
    "tab.activeBorder": "#f4c623",
    "tab.activeBorderTop": "#f4c623",
    "panel.border": "#9FC6A0",
    "tab.activeBackground": "#f4c623",
    "sideBar.border": "#8795A1",
    "sideBarTitle.foreground": "#f4c623",
    "sideBarSectionHeader.border": "#3f533c",
    "list.hoverForeground": "#141C22",
    "sideBar.foreground": "#8795A1",
    "activityBar.border": "#2f5322"
  },
  "semanticTokenColors": {
    "namespace": "#b7b3ee",
    "type": "#aad49a",
    "class": "#aad49a",
    "enum": "#aad49a",
    "interface": "#aad49a",
    "struct": "#aad49a",
    "typeParameter": "#8dba9c",
    "parameter": "#75b3ed",
    "variable": "#c2cbc5",
    "variable.readonly": "#a9a7c9",
    "variable.defaultLibrary": "#fd6c58",
    "property": "#b7b3ee",
    "property.readonly": "#a9a7c9",
    "enumMember": "#a9a7c9",
    "event": "#b7b3ee",
    "function": "#67d4dc",
    "function.defaultLibrary": "#b7b3ee",
    "method": "#67d4dc",
    "method.defaultLibrary": "#b7b3ee",
    "macro": "#d08d52",
    "label": "#ffdc77",
    "decorator": "#52c1c9",
    "selfParameter": "#eae8ff",
    "builtinConstant": "#8dba9c",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#8dba9c",
    "variable.readonly:go": "#a9a7c9",
    "selfParameter:python": "#eae8ff",
    "clsParameter:python": "#eae8ff",
    "magicFunction:python": "#b7b3ee",
    "builtinConstant:python": "#8dba9c",
    "module:python": "#b7b3ee",
    "variable.defaultLibrary:typescript": "#ff8e7c",
    "variable.defaultLibrary:javascript": "#ff8e7c",
    "lifetime:rust": "#d08d52",
    "builtinType:rust": "#8dba9c",
    "decorator:python": "#52c1c9",
    "function.decorator": "#52c1c9",
    "method.decorator": "#52c1c9",
    "class.decorator": "#52c1c9",
    "function.decorator:python": "#52c1c9",
    "class.decorator:python": "#52c1c9"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#c2cbc5"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#c2cbc5"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#8795A1"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d08d52"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#8dba9c"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#a9a7c9"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#fd6c58"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7b3ee"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#aad49a"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#fd6c58"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#67d4dc"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7b3ee"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#b1c2d4"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff5f56"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7b3ee"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7b3ee"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#c7c2ff"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2c840"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7b3ee"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2c840"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2c840"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7b3ee"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#a0bd95"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#fd6c58"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#ff8e7c"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#d08d52"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#c2cbc5"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2c840"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#a0bd95"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#d08d52"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2c840"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffdc77"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#d08d52"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2c840"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#d9e2d4"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#d76767"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#d28b58"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#70bfa7"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b7b3ee"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#9FC6A0"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#75b3ed"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffad9f"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#f2c840"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2c840"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#d8d6ff"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#7f9fbe"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#d6a95c"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b08db4"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#fd6c58"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#eae8ff"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#52c1c9"
      }
    },
    {
      "name": "Python triple-quoted strings / docstrings",
      "scope": [
        "string.quoted.docstring.multi.python",
        "string.quoted.multi.python"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#C9C2E8"
      }
    },
    {
      "name": "Python import keywords",
      "scope": "keyword.control.import.python",
      "settings": {
        "fontStyle": "",
        "foreground": "#6FA8D8"
      }
    }
  ]
}
