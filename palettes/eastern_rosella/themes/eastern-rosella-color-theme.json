{
  "$schema": "vscode://schemas/color-theme",
  "name": "Eastern Rosella",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#46574b",
    "list.activeSelectionBackground": "#647569",
    "quickInputList.focusBackground": "#647569",
    "list.inactiveSelectionBackground": "#425347",
    "list.hoverBackground": "#38493e",
    "list.highlightForeground": "#d88c48",
    "button.background": "#4a5b4f",
    "editor.background": "#182229",
    "editor.foreground": "#c1cac4",
    "editor.selectionBackground": "#616c7880",
    "minimap.selectionHighlight": "#616c7880",
    "editor.selectionHighlightBackground": "#515c6880",
    "editor.lineHighlightBackground": "#25342a",
    "editorLineNumber.activeForeground": "#8e9791",
    "editor.wordHighlightBackground": "#53469580",
    "editor.wordHighlightStrongBackground": "#7367bd80",
    "editorCursor.foreground": "#ba7433",
    "editorWhitespace.foreground": "#604c00",
    "editorIndentGuide.background1": "#604c00",
    "editorIndentGuide.activeBackground1": "#866b00",
    "editorGroupHeader.tabsBackground": "#1d2c22",
    "tab.inactiveBackground": "#35453a",
    "tab.border": "#25342a",
    "tab.inactiveForeground": "#d2dbd5",
    "tab.lastPinnedBorder": "#445549",
    "peekView.border": "#3f6184",
    "panelTitle.activeForeground": "#ffffff",
    "statusBar.background": "#445549",
    "statusBar.debuggingBackground": "#445549",
    "statusBar.noFolderBackground": "#445549",
    "titleBar.activeBackground": "#445549",
    "statusBarItem.remoteBackground": "#3f6184",
    "ports.iconRunningProcessForeground": "#c6cfc9",
    "activityBar.background": "#2a3a2f",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#3f6184",
    "sideBar.background": "#1c2b21",
    "sideBarSectionHeader.background": "#445549",
    "menu.background": "#1c2b21",
    "menu.foreground": "#c6cfc9",
    "pickerGroup.foreground": "#aab3ad",
    "inputOption.activeBorder": "#3f6184",
    "focusBorder": "#3f6184",
    "agentsPanel.border": "#25342a",
    "agentsChatInput.border": "#25342a",
    "agentsChatInput.focusBorder": "#3f6184",
    "agentsNewSessionButton.border": "#25342a",
    "terminal.ansiBlack": "#182229",
    "terminal.ansiRed": "#d3355b",
    "terminal.ansiGreen": "#87b42a",
    "terminal.ansiYellow": "#acb632",
    "terminal.ansiBlue": "#707cc7",
    "terminal.ansiMagenta": "#896cca",
    "terminal.ansiCyan": "#55adba",
    "terminal.ansiWhite": "#e3e3dd",
    "terminal.ansiBrightBlack": "#5a6b5f",
    "terminal.ansiBrightRed": "#fb2661",
    "terminal.ansiBrightGreen": "#a7e22c",
    "terminal.ansiBrightYellow": "#d9e539",
    "terminal.ansiBrightBlue": "#8998fe",
    "terminal.ansiBrightMagenta": "#d6d4ff",
    "terminal.ansiBrightCyan": "#65daec",
    "terminal.ansiBrightWhite": "#f8f8f2",
    "terminal.inactiveSelectionBackground": "#616c7840",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#b2adec",
    "type": "#86b275",
    "class": "#86b275",
    "enum": "#86b275",
    "interface": "#86b275",
    "struct": "#86b275",
    "typeParameter": "#8fc09f",
    "parameter": "#839ab2",
    "variable": "#c1cac4",
    "variable.readonly": "#a2a0c4",
    "variable.defaultLibrary": "#ff8876",
    "property": "#b2adec",
    "property.readonly": "#a2a0c4",
    "enumMember": "#a2a0c4",
    "event": "#b2adec",
    "function": "#5fdce4",
    "function.defaultLibrary": "#b2adec",
    "method": "#5fdce4",
    "method.defaultLibrary": "#b2adec",
    "macro": "#cb8649",
    "label": "#efc11c",
    "decorator": "#48bfc6",
    "selfParameter": "#eae8ff",
    "builtinConstant": "#8fc09f",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#8fc09f",
    "variable.readonly:go": "#a2a0c4",
    "selfParameter:python": "#eae8ff",
    "clsParameter:python": "#eae8ff",
    "magicFunction:python": "#b2adec",
    "builtinConstant:python": "#8fc09f",
    "module:python": "#b2adec",
    "variable.defaultLibrary:typescript": "#fb6854",
    "variable.defaultLibrary:javascript": "#fb6854",
    "lifetime:rust": "#cb8649",
    "builtinType:rust": "#8fc09f",
    "decorator:python": "#48bfc6",
    "function.decorator": "#48bfc6",
    "method.decorator": "#48bfc6",
    "class.decorator": "#48bfc6",
    "function.decorator:python": "#48bfc6",
    "class.decorator:python": "#48bfc6"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#c1cac4"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#c1cac4"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#8795A1"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb8649"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#839ab2"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#8fc09f"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#a2a0c4"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff8876"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#b2adec"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#86b275"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#ff8876"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#5fdce4"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#839ab2"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#b2adec"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#9aabbe"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#839ab2"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff0b00"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#839ab2"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#b2adec"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#b2adec"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#c4beff"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#daaf02"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#839ab2"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#b2adec"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#daaf02"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#839ab2"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#daaf02"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#839ab2"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#b2adec"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#67825d"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff8876"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#fb6854"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#cb8649"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#c1cac4"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#daaf02"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#67825d"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb8649"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#daaf02"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#efc11c"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#cb8649"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#daaf02"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#e03733"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cf4f1c"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b2adec"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#9ebf65"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#839ab2"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffa899"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#daaf02"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#daaf02"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#d6d4ff"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#ff8876"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#eae8ff"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#48bfc6"
      }
    }
  ]
}
