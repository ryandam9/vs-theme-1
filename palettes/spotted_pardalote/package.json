{
  "name": "spotted-pardalote",
  "displayName": "Spotted Pardalote",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Spotted Pardalote palette.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "dark",
    "semantic highlighting",
    "theme",
    "Spotted Pardalote"
  ],
  "galleryBanner": {
    "color": "#2a1916",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Spotted Pardalote",
        "label": "Spotted Pardalote",
        "uiTheme": "vs-dark",
        "path": "./themes/spotted-pardalote-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js spotted_pardalote",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && node ../../scripts/install-local.js"
  }
}
