{
  "name": "galah",
  "displayName": "Galah",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Galah palette.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "light",
    "semantic highlighting",
    "theme",
    "Galah"
  ],
  "galleryBanner": {
    "color": "#fff8f8",
    "theme": "light"
  },
  "contributes": {
    "themes": [
      {
        "id": "Galah",
        "label": "Galah",
        "uiTheme": "vs",
        "path": "./themes/galah-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js galah",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && node ../../scripts/install-local.js"
  }
}
