{
  "name": "yellow-robin",
  "displayName": "Yellow Robin",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Yellow Robin palette.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "dark",
    "semantic highlighting",
    "theme",
    "Yellow Robin"
  ],
  "galleryBanner": {
    "color": "#221e0e",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Yellow Robin",
        "label": "Yellow Robin",
        "uiTheme": "vs-dark",
        "path": "./themes/yellow-robin-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js yellow_robin",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && code --install-extension yellow-robin-1.0.0.vsix --force"
  }
}
