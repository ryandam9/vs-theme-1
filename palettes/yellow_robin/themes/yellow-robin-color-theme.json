{
  "$schema": "vscode://schemas/color-theme",
  "name": "Yellow Robin",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#565241",
    "list.activeSelectionBackground": "#75705e",
    "quickInputList.focusBackground": "#75705e",
    "list.inactiveSelectionBackground": "#524e3d",
    "list.hoverBackground": "#484433",
    "list.highlightForeground": "#d29300",
    "button.background": "#5a5645",
    "editor.background": "#221e0e",
    "editor.foreground": "#cac7bd",
    "editor.selectionBackground": "#666b7480",
    "minimap.selectionHighlight": "#666b7480",
    "editor.selectionHighlightBackground": "#565b6480",
    "editor.lineHighlightBackground": "#343020",
    "editorLineNumber.activeForeground": "#96948b",
    "editor.wordHighlightBackground": "#47518280",
    "editor.wordHighlightStrongBackground": "#6672a980",
    "editorCursor.foreground": "#b17b00",
    "editorWhitespace.foreground": "#585000",
    "editorIndentGuide.background1": "#585000",
    "editorIndentGuide.activeBackground1": "#7a7005",
    "editorGroupHeader.tabsBackground": "#2c2818",
    "tab.inactiveBackground": "#44402f",
    "tab.border": "#343020",
    "tab.inactiveForeground": "#dbd8ce",
    "tab.lastPinnedBorder": "#54503f",
    "peekView.border": "#4b5e81",
    "panelTitle.activeForeground": "#ffffff",
    "statusBar.background": "#54503f",
    "statusBar.debuggingBackground": "#54503f",
    "statusBar.noFolderBackground": "#54503f",
    "titleBar.activeBackground": "#54503f",
    "statusBarItem.remoteBackground": "#4b5e81",
    "ports.iconRunningProcessForeground": "#cfccc2",
    "activityBar.background": "#393525",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#4b5e81",
    "sideBar.background": "#2b2717",
    "sideBarSectionHeader.background": "#54503f",
    "menu.background": "#2b2717",
    "menu.foreground": "#cfccc2",
    "pickerGroup.foreground": "#b2b0a7",
    "inputOption.activeBorder": "#4b5e81",
    "focusBorder": "#4b5e81",
    "agentsPanel.border": "#343020",
    "agentsChatInput.border": "#343020",
    "agentsChatInput.focusBorder": "#4b5e81",
    "agentsNewSessionButton.border": "#343020",
    "terminal.ansiBlack": "#221e0e",
    "terminal.ansiRed": "#d43555",
    "terminal.ansiGreen": "#94b111",
    "terminal.ansiYellow": "#b6b328",
    "terminal.ansiBlue": "#6a7ec8",
    "terminal.ansiMagenta": "#9169c5",
    "terminal.ansiCyan": "#56adbc",
    "terminal.ansiWhite": "#e3e3dd",
    "terminal.ansiBrightBlack": "#6b6654",
    "terminal.ansiBrightRed": "#fc265a",
    "terminal.ansiBrightGreen": "#b8dd00",
    "terminal.ansiBrightYellow": "#e6e129",
    "terminal.ansiBrightBlue": "#819aff",
    "terminal.ansiBrightMagenta": "#e6baff",
    "terminal.ansiBrightCyan": "#66d9ee",
    "terminal.ansiBrightWhite": "#f8f8f2",
    "terminal.inactiveSelectionBackground": "#666b7440",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#bb9acd",
    "type": "#6eb68a",
    "class": "#6eb68a",
    "enum": "#6eb68a",
    "interface": "#6eb68a",
    "struct": "#6eb68a",
    "typeParameter": "#85c79e",
    "parameter": "#8c97ad",
    "variable": "#cac7bd",
    "variable.readonly": "#8490c2",
    "variable.defaultLibrary": "#e5957a",
    "property": "#bb9acd",
    "property.readonly": "#8490c2",
    "enumMember": "#8490c2",
    "event": "#bb9acd",
    "function": "#7bd7e6",
    "function.defaultLibrary": "#bb9acd",
    "method": "#7bd7e6",
    "method.defaultLibrary": "#bb9acd",
    "macro": "#d5960c",
    "label": "#fdea99",
    "decorator": "#66b9c7",
    "selfParameter": "#efd5ff",
    "builtinConstant": "#85c79e",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#85c79e",
    "variable.readonly:go": "#8490c2",
    "selfParameter:python": "#efd5ff",
    "clsParameter:python": "#efd5ff",
    "magicFunction:python": "#bb9acd",
    "builtinConstant:python": "#85c79e",
    "module:python": "#bb9acd",
    "variable.defaultLibrary:typescript": "#d0846b",
    "variable.defaultLibrary:javascript": "#d0846b",
    "lifetime:rust": "#d5960c",
    "builtinType:rust": "#85c79e",
    "decorator:python": "#66b9c7",
    "function.decorator": "#66b9c7",
    "method.decorator": "#66b9c7",
    "class.decorator": "#66b9c7",
    "function.decorator:python": "#66b9c7",
    "class.decorator:python": "#66b9c7"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#cac7bd"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#cac7bd"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#bb8728"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#d5c741"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d5960c"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#85c79e"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#8490c2"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#e5957a"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#bb9acd"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#6eb68a"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#e5957a"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#7bd7e6"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#bb9acd"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#a1a9b9"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff0b00"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#bb9acd"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#bb9acd"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#cdade0"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#d5c741"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d5c741"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#bb9acd"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#d5c741"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d5c741"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#bb9acd"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#598469"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#e5957a"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#d0846b"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#d5960c"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#cac7bd"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#d5c741"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#598469"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#d5960c"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#d5c741"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#fdea99"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#d5960c"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#dc322f"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#bb9acd"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#d5c741"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#8c97ad"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffa485"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#e8d78d"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#e6baff"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#e5957a"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#efd5ff"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#66b9c7"
      }
    }
  ]
}
