{
  "$schema": "vscode://schemas/color-theme",
  "name": "Superb Fairywren",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#5e4f46",
    "list.activeSelectionBackground": "#7c6d63",
    "quickInputList.focusBackground": "#7c6d63",
    "list.inactiveSelectionBackground": "#5a4b42",
    "list.hoverBackground": "#4f4138",
    "list.highlightForeground": "#d18f5e",
    "button.background": "#625349",
    "editor.background": "#281b13",
    "editor.foreground": "#cdc5c1",
    "editor.selectionBackground": "#4c708780",
    "minimap.selectionHighlight": "#4c708780",
    "editor.selectionHighlightBackground": "#3d5f7680",
    "editor.lineHighlightBackground": "#3a2d24",
    "editorLineNumber.activeForeground": "#9a928e",
    "editor.wordHighlightBackground": "#53498c80",
    "editor.wordHighlightStrongBackground": "#736ab480",
    "editorCursor.foreground": "#b37749",
    "editorWhitespace.foreground": "#525123",
    "editorIndentGuide.background1": "#525123",
    "editorIndentGuide.activeBackground1": "#727143",
    "editorGroupHeader.tabsBackground": "#32251d",
    "tab.inactiveBackground": "#4b3d34",
    "tab.border": "#3a2d24",
    "tab.inactiveForeground": "#ded6d2",
    "tab.lastPinnedBorder": "#5c4d44",
    "peekView.border": "#5b5396",
    "panelTitle.activeForeground": "#ffffff",
    "statusBar.background": "#5c4d44",
    "statusBar.debuggingBackground": "#5c4d44",
    "statusBar.noFolderBackground": "#5c4d44",
    "titleBar.activeBackground": "#5c4d44",
    "statusBarItem.remoteBackground": "#5b5396",
    "ports.iconRunningProcessForeground": "#d2cac6",
    "activityBar.background": "#403229",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#5b5396",
    "sideBar.background": "#31241c",
    "sideBarSectionHeader.background": "#5c4d44",
    "menu.background": "#31241c",
    "menu.foreground": "#d2cac6",
    "pickerGroup.foreground": "#b6aeaa",
    "inputOption.activeBorder": "#5b5396",
    "focusBorder": "#5b5396",
    "agentsPanel.border": "#3a2d24",
    "agentsChatInput.border": "#3a2d24",
    "agentsChatInput.focusBorder": "#5b5396",
    "agentsNewSessionButton.border": "#3a2d24",
    "terminal.ansiBlack": "#281b13",
    "terminal.ansiRed": "#d13567",
    "terminal.ansiGreen": "#88b428",
    "terminal.ansiYellow": "#b4b42a",
    "terminal.ansiBlue": "#707cc8",
    "terminal.ansiMagenta": "#886cca",
    "terminal.ansiCyan": "#55aeb8",
    "terminal.ansiWhite": "#e3e3dd",
    "terminal.ansiBrightBlack": "#726359",
    "terminal.ansiBrightRed": "#f92671",
    "terminal.ansiBrightGreen": "#a9e129",
    "terminal.ansiBrightYellow": "#e3e22d",
    "terminal.ansiBrightBlue": "#8998fe",
    "terminal.ansiBrightMagenta": "#b3acf9",
    "terminal.ansiBrightCyan": "#64dae9",
    "terminal.ansiBrightWhite": "#f8f8f2",
    "terminal.inactiveSelectionBackground": "#4c708740",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#ca96bb",
    "type": "#83b378",
    "class": "#83b378",
    "enum": "#83b378",
    "interface": "#83b378",
    "struct": "#83b378",
    "typeParameter": "#72d0c9",
    "parameter": "#659fc5",
    "variable": "#cdc5c1",
    "variable.readonly": "#a19ae5",
    "variable.defaultLibrary": "#e7918b",
    "property": "#ca96bb",
    "property.readonly": "#a19ae5",
    "enumMember": "#a19ae5",
    "event": "#ca96bb",
    "function": "#86e3dc",
    "function.defaultLibrary": "#ca96bb",
    "method": "#86e3dc",
    "method.defaultLibrary": "#ca96bb",
    "macro": "#c48a5f",
    "label": "#f2d889",
    "decorator": "#67bcb6",
    "selfParameter": "#f8b5e5",
    "builtinConstant": "#72d0c9",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#72d0c9",
    "variable.readonly:go": "#a19ae5",
    "selfParameter:python": "#f8b5e5",
    "clsParameter:python": "#f8b5e5",
    "magicFunction:python": "#ca96bb",
    "builtinConstant:python": "#72d0c9",
    "module:python": "#ca96bb",
    "variable.defaultLibrary:typescript": "#d1817a",
    "variable.defaultLibrary:javascript": "#d1817a",
    "lifetime:rust": "#c48a5f",
    "builtinType:rust": "#72d0c9",
    "decorator:python": "#67bcb6",
    "function.decorator": "#67bcb6",
    "method.decorator": "#67bcb6",
    "class.decorator": "#67bcb6",
    "function.decorator:python": "#67bcb6",
    "class.decorator:python": "#67bcb6"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#cdc5c1"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#cdc5c1"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#8f7e65"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#c48a5f"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#659fc5"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#72d0c9"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#a19ae5"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#e7918b"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#ca96bb"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#83b378"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#e7918b"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#86e3dc"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#659fc5"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#ca96bb"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#7eb0d2"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#659fc5"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff0b00"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#659fc5"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#ca96bb"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#ca96bb"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#dda8ce"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#dec67d"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#659fc5"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#ca96bb"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#dec67d"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#659fc5"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#dec67d"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#659fc5"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#ca96bb"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#65825e"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#e7918b"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#d1817a"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#c48a5f"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#cdc5c1"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#dec67d"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#65825e"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#c48a5f"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#dec67d"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#f2d889"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#c48a5f"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#dec67d"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#dc322f"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#ca96bb"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#a5bb7a"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#659fc5"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#ce6a7e"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#dec67d"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#dec67d"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#b3acf9"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#e7918b"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#f8b5e5"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#67bcb6"
      }
    }
  ]
}
