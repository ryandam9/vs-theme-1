{
  "name": "superb-fairywren",
  "displayName": "Superb Fairywren",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Superb Fairywren palette.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "dark",
    "semantic highlighting",
    "theme",
    "Superb Fairywren"
  ],
  "galleryBanner": {
    "color": "#281b13",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Superb Fairywren",
        "label": "Superb Fairywren",
        "uiTheme": "vs-dark",
        "path": "./themes/superb-fairywren-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js superb_fairy_wren",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && code --install-extension superb-fairywren-1.0.0.vsix --force"
  }
}
