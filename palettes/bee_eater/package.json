{
  "name": "bee-eater",
  "displayName": "Bee-eater",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Bee-eater palette.",
  "version": "1.0.2",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "dark",
    "semantic highlighting",
    "theme",
    "Bee-eater"
  ],
  "galleryBanner": {
    "color": "#151f2b",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Bee-eater",
        "label": "Bee-eater",
        "uiTheme": "vs-dark",
        "path": "./themes/bee-eater-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js bee_eater",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && node ../../scripts/install-local.js"
  }
}
