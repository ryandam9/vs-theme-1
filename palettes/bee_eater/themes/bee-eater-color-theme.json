{
  "$schema": "vscode://schemas/color-theme",
  "name": "Bee-eater",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#485362",
    "list.activeSelectionBackground": "#667181",
    "quickInputList.focusBackground": "#667181",
    "list.inactiveSelectionBackground": "#444f5e",
    "list.hoverBackground": "#3a4553",
    "list.highlightForeground": "#d88e00",
    "button.background": "#4c5766",
    "editor.background": "#151f2b",
    "editor.foreground": "#c1c8d0",
    "editor.selectionBackground": "#4f6c9480",
    "minimap.selectionHighlight": "#4f6c9480",
    "editor.selectionHighlightBackground": "#3f5c8380",
    "editor.lineHighlightBackground": "#27313e",
    "editorLineNumber.activeForeground": "#8f959d",
    "editor.wordHighlightBackground": "#51449c80",
    "editor.wordHighlightStrongBackground": "#7166c380",
    "editorCursor.foreground": "#b67700",
    "editorWhitespace.foreground": "#5c4e00",
    "editorIndentGuide.background1": "#5c4e00",
    "editorIndentGuide.activeBackground1": "#806e03",
    "editorGroupHeader.tabsBackground": "#1f2936",
    "tab.inactiveBackground": "#36414f",
    "tab.border": "#27313e",
    "tab.inactiveForeground": "#d2d9e2",
    "tab.lastPinnedBorder": "#465160",
    "peekView.border": "#275ea3",
    "panelTitle.activeForeground": "#ffffff",
    "statusBar.background": "#465160",
    "statusBar.debuggingBackground": "#465160",
    "statusBar.noFolderBackground": "#465160",
    "titleBar.activeBackground": "#465160",
    "statusBarItem.remoteBackground": "#275ea3",
    "ports.iconRunningProcessForeground": "#c6cdd5",
    "activityBar.background": "#2c3644",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#275ea3",
    "sideBar.background": "#1e2835",
    "sideBarSectionHeader.background": "#465160",
    "menu.background": "#1e2835",
    "menu.foreground": "#c6cdd5",
    "pickerGroup.foreground": "#aab1b9",
    "inputOption.activeBorder": "#275ea3",
    "focusBorder": "#275ea3",
    "agentsPanel.border": "#27313e",
    "agentsChatInput.border": "#27313e",
    "agentsChatInput.focusBorder": "#275ea3",
    "agentsNewSessionButton.border": "#27313e",
    "terminal.ansiBlack": "#151f2b",
    "terminal.ansiRed": "#d53740",
    "terminal.ansiGreen": "#89b327",
    "terminal.ansiYellow": "#afb52f",
    "terminal.ansiBlue": "#6f7cc8",
    "terminal.ansiMagenta": "#886cca",
    "terminal.ansiCyan": "#58acc0",
    "terminal.ansiWhite": "#e3e3dd",
    "terminal.ansiBrightBlack": "#5c6776",
    "terminal.ansiBrightRed": "#fd2a3d",
    "terminal.ansiBrightGreen": "#aae126",
    "terminal.ansiBrightYellow": "#dde435",
    "terminal.ansiBrightBlue": "#8898fe",
    "terminal.ansiBrightMagenta": "#d5d4ff",
    "terminal.ansiBrightCyan": "#69d8f3",
    "terminal.ansiBrightWhite": "#f8f8f2",
    "terminal.inactiveSelectionBackground": "#4f6c9440",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#b0acf5",
    "type": "#96b143",
    "class": "#96b143",
    "enum": "#96b143",
    "interface": "#96b143",
    "struct": "#96b143",
    "typeParameter": "#4cd8b9",
    "parameter": "#6b99d6",
    "variable": "#c1c8d0",
    "variable.readonly": "#a1a0c9",
    "variable.defaultLibrary": "#f5a200",
    "property": "#b0acf5",
    "property.readonly": "#a1a0c9",
    "enumMember": "#a1a0c9",
    "event": "#b0acf5",
    "function": "#73d4ff",
    "function.defaultLibrary": "#b0acf5",
    "method": "#73d4ff",
    "method.defaultLibrary": "#b0acf5",
    "macro": "#ffd39c",
    "label": "#f7da4a",
    "decorator": "#40c4a7",
    "selfParameter": "#e9e9ff",
    "builtinConstant": "#4cd8b9",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#4cd8b9",
    "variable.readonly:go": "#a1a0c9",
    "selfParameter:python": "#e9e9ff",
    "clsParameter:python": "#e9e9ff",
    "magicFunction:python": "#b0acf5",
    "builtinConstant:python": "#4cd8b9",
    "module:python": "#b0acf5",
    "variable.defaultLibrary:typescript": "#dd9200",
    "variable.defaultLibrary:javascript": "#dd9200",
    "lifetime:rust": "#ffd39c",
    "builtinType:rust": "#4cd8b9",
    "decorator:python": "#40c4a7",
    "function.decorator": "#40c4a7",
    "method.decorator": "#40c4a7",
    "class.decorator": "#40c4a7",
    "function.decorator:python": "#40c4a7",
    "class.decorator:python": "#40c4a7"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#c1c8d0"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#c1c8d0"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#889484"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffd39c"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#4cd8b9"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#a1a0c9"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#f5a200"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#b0acf5"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#96b143"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#f5a200"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#73d4ff"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#b0acf5"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#81abe3"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff0b00"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#b0acf5"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#b0acf5"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#c2bfff"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#b0acf5"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#b0acf5"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#6e8235"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#f5a200"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#dd9200"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#ffd39c"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#c1c8d0"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#6e8235"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffd39c"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#f7da4a"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#ffd39c"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#e03733"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b0acf5"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#a8c35c"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#6b99d6"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffb959"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#e2c73e"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#d5d4ff"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#f5a200"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#e9e9ff"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#40c4a7"
      }
    }
  ]
}
