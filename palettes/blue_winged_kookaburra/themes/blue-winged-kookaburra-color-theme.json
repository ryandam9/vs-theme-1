{
  "$schema": "vscode://schemas/color-theme",
  "name": "Blue-winged Kookaburra",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#102e42",
    "list.activeSelectionBackground": "#205b78",
    "quickInputList.focusBackground": "#205b78",
    "list.inactiveSelectionBackground": "#1b4259",
    "list.hoverBackground": "#15354a",
    "list.highlightForeground": "#d7854d",
    "button.background": "#174a66",
    "editor.background": "#081521",
    "editor.foreground": "#e2ddd0",
    "editor.selectionBackground": "#0b5e8680",
    "minimap.selectionHighlight": "#0b5e8680",
    "editor.selectionHighlightBackground": "#104a6980",
    "editor.lineHighlightBackground": "#163149",
    "editorLineNumber.activeForeground": "#7f8b92",
    "editor.wordHighlightBackground": "#123c7280",
    "editor.wordHighlightStrongBackground": "#175a9880",
    "editorCursor.foreground": "#c45829",
    "editorWhitespace.foreground": "#2b4858",
    "editorIndentGuide.background1": "#2b4858",
    "editorIndentGuide.activeBackground1": "#41677a",
    "editorGroupHeader.tabsBackground": "#0b1d2c",
    "tab.inactiveBackground": "#10283a",
    "tab.border": "#163149",
    "tab.inactiveForeground": "#e1e2dd",
    "tab.lastPinnedBorder": "#0c2a3d",
    "peekView.border": "#0b7595",
    "panelTitle.activeForeground": "#f7f4ea",
    "statusBar.background": "#0c2a3d",
    "statusBar.debuggingBackground": "#0c2a3d",
    "statusBar.noFolderBackground": "#0c2a3d",
    "titleBar.activeBackground": "#0c2a3d",
    "statusBarItem.remoteBackground": "#0b7595",
    "ports.iconRunningProcessForeground": "#d0d4d7",
    "activityBar.background": "#0a2130",
    "activityBar.foreground": "#f7f4ea",
    "activityBarBadge.background": "#0b7595",
    "sideBar.background": "#0a1a29",
    "sideBarSectionHeader.background": "#0c2a3d",
    "menu.background": "#0a1a29",
    "menu.foreground": "#d0d4d7",
    "pickerGroup.foreground": "#a9b2b7",
    "inputOption.activeBorder": "#0b7595",
    "focusBorder": "#0b7595",
    "agentsPanel.border": "#163149",
    "agentsChatInput.border": "#163149",
    "agentsChatInput.focusBorder": "#0b7595",
    "agentsNewSessionButton.border": "#163149",
    "terminal.ansiBlack": "#081521",
    "terminal.ansiRed": "#c96468",
    "terminal.ansiGreen": "#8aa97a",
    "terminal.ansiYellow": "#c8a667",
    "terminal.ansiBlue": "#4f82b8",
    "terminal.ansiMagenta": "#8e86ad",
    "terminal.ansiCyan": "#4fa0b4",
    "terminal.ansiWhite": "#d8d6cf",
    "terminal.ansiBrightBlack": "#4a6272",
    "terminal.ansiBrightRed": "#e27b7e",
    "terminal.ansiBrightGreen": "#a8c58d",
    "terminal.ansiBrightYellow": "#e0c07b",
    "terminal.ansiBrightBlue": "#69a7d6",
    "terminal.ansiBrightMagenta": "#b8bcd8",
    "terminal.ansiBrightCyan": "#72c4d6",
    "terminal.ansiBrightWhite": "#f7f4ea",
    "terminal.inactiveSelectionBackground": "#0b5e8640",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#9cb4c4",
    "type": "#59a8d0",
    "class": "#59a8d0",
    "enum": "#59a8d0",
    "interface": "#59a8d0",
    "struct": "#59a8d0",
    "typeParameter": "#73c9dc",
    "parameter": "#78b8df",
    "variable": "#e2ddd0",
    "variable.readonly": "#7ea8d8",
    "variable.defaultLibrary": "#d96c62",
    "property": "#9cb4c4",
    "property.readonly": "#7ea8d8",
    "enumMember": "#7ea8d8",
    "event": "#9cb4c4",
    "function": "#b5effb",
    "function.defaultLibrary": "#9cb4c4",
    "method": "#b5effb",
    "method.defaultLibrary": "#9cb4c4",
    "macro": "#c97542",
    "label": "#e0b67c",
    "decorator": "#3e9ab2",
    "selfParameter": "#d2693d",
    "builtinConstant": "#73c9dc",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#73c9dc",
    "variable.readonly:go": "#7ea8d8",
    "selfParameter:python": "#d2693d",
    "clsParameter:python": "#d2693d",
    "magicFunction:python": "#9cb4c4",
    "builtinConstant:python": "#73c9dc",
    "module:python": "#9cb4c4",
    "variable.defaultLibrary:typescript": "#cf7b64",
    "variable.defaultLibrary:javascript": "#cf7b64",
    "lifetime:rust": "#c97542",
    "builtinType:rust": "#73c9dc",
    "decorator:python": "#3e9ab2",
    "function.decorator": "#3e9ab2",
    "method.decorator": "#3e9ab2",
    "class.decorator": "#3e9ab2",
    "function.decorator:python": "#3e9ab2",
    "class.decorator:python": "#3e9ab2"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#e2ddd0"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#e2ddd0"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#9a9188"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#c97542"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#78b8df"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#73c9dc"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#7ea8d8"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#d96c62"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#9cb4c4"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#59a8d0"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#d96c62"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#b5effb"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#78b8df"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#9cb4c4"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#bfc7cd"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#78b8df"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff6b5e"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#78b8df"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#9cb4c4"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#9cb4c4"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#d4d8e3"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#78b8df"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#9cb4c4"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#78b8df"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#78b8df"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#9cb4c4"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#a7a6a1"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#d96c62"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#cf7b64"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#c97542"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#e2ddd0"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#a7a6a1"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#c97542"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#e0b67c"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#c97542"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#dc322f"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#9cb4c4"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#d8c7a1"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#78b8df"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#d58e99"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#d8b98f"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#b8bcd8"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#d96c62"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#d2693d"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#3e9ab2"
      }
    }
  ]
}
