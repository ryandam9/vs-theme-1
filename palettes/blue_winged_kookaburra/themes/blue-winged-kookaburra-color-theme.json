{
  "$schema": "vscode://schemas/color-theme",
  "name": "Blue-winged Kookaburra",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#475461",
    "list.activeSelectionBackground": "#647280",
    "quickInputList.focusBackground": "#647280",
    "list.inactiveSelectionBackground": "#43505d",
    "list.hoverBackground": "#394653",
    "list.highlightForeground": "#d88a69",
    "button.background": "#4b5865",
    "editor.background": "#141f2b",
    "editor.foreground": "#c1c8cf",
    "editor.selectionBackground": "#4c6d9580",
    "minimap.selectionHighlight": "#4c6d9580",
    "editor.selectionHighlightBackground": "#3c5d8480",
    "editor.lineHighlightBackground": "#25313e",
    "editorLineNumber.activeForeground": "#8e959c",
    "editor.wordHighlightBackground": "#4c508180",
    "editor.wordHighlightStrongBackground": "#6b70a880",
    "editorCursor.foreground": "#b97254",
    "editorWhitespace.foreground": "#6d4130",
    "editorIndentGuide.background1": "#6d4130",
    "editorIndentGuide.activeBackground1": "#8f614f",
    "editorGroupHeader.tabsBackground": "#1e2936",
    "tab.inactiveBackground": "#35424f",
    "tab.border": "#25313e",
    "tab.inactiveForeground": "#d2d9e0",
    "tab.lastPinnedBorder": "#45525f",
    "peekView.border": "#555988",
    "panelTitle.activeForeground": "#ffffff",
    "statusBar.background": "#45525f",
    "statusBar.debuggingBackground": "#45525f",
    "statusBar.noFolderBackground": "#45525f",
    "titleBar.activeBackground": "#45525f",
    "statusBarItem.remoteBackground": "#555988",
    "ports.iconRunningProcessForeground": "#c6cdd4",
    "activityBar.background": "#2a3643",
    "activityBar.foreground": "#ffffff",
    "activityBarBadge.background": "#555988",
    "sideBar.background": "#1d2834",
    "sideBarSectionHeader.background": "#45525f",
    "menu.background": "#1d2834",
    "menu.foreground": "#c6cdd4",
    "pickerGroup.foreground": "#aab1b8",
    "inputOption.activeBorder": "#555988",
    "focusBorder": "#555988",
    "agentsPanel.border": "#25313e",
    "agentsChatInput.border": "#25313e",
    "agentsChatInput.focusBorder": "#555988",
    "agentsNewSessionButton.border": "#25313e",
    "terminal.ansiBlack": "#141f2b",
    "terminal.ansiRed": "#d23564",
    "terminal.ansiGreen": "#afa700",
    "terminal.ansiYellow": "#cda911",
    "terminal.ansiBlue": "#6d7dc8",
    "terminal.ansiMagenta": "#866dcb",
    "terminal.ansiCyan": "#56adbc",
    "terminal.ansiWhite": "#e4e2dd",
    "terminal.ansiBrightBlack": "#5a6876",
    "terminal.ansiBrightRed": "#fa266e",
    "terminal.ansiBrightGreen": "#dbd100",
    "terminal.ansiBrightYellow": "#ffd537",
    "terminal.ansiBrightBlue": "#8599ff",
    "terminal.ansiBrightMagenta": "#acb2e6",
    "terminal.ansiBrightCyan": "#66d9ef",
    "terminal.ansiBrightWhite": "#f9f7f2",
    "terminal.inactiveSelectionBackground": "#4c6d9540",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#b7a0bd",
    "type": "#6ab9c8",
    "class": "#6ab9c8",
    "enum": "#6ab9c8",
    "interface": "#6ab9c8",
    "struct": "#6ab9c8",
    "typeParameter": "#96ddeb",
    "parameter": "#799bbd",
    "variable": "#c1c8cf",
    "variable.readonly": "#9aa0d4",
    "variable.defaultLibrary": "#d38089",
    "property": "#b7a0bd",
    "property.readonly": "#9aa0d4",
    "enumMember": "#9aa0d4",
    "event": "#b7a0bd",
    "function": "#aaf0ff",
    "function.defaultLibrary": "#b7a0bd",
    "method": "#aaf0ff",
    "method.defaultLibrary": "#b7a0bd",
    "macro": "#d79073",
    "label": "#ffb496",
    "decorator": "#66a4b1",
    "selfParameter": "#e2c0eb",
    "builtinConstant": "#96ddeb",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#96ddeb",
    "variable.readonly:go": "#9aa0d4",
    "selfParameter:python": "#e2c0eb",
    "clsParameter:python": "#e2c0eb",
    "magicFunction:python": "#b7a0bd",
    "builtinConstant:python": "#96ddeb",
    "module:python": "#b7a0bd",
    "variable.defaultLibrary:typescript": "#e5939c",
    "variable.defaultLibrary:javascript": "#e5939c",
    "lifetime:rust": "#d79073",
    "builtinType:rust": "#96ddeb",
    "decorator:python": "#66a4b1",
    "function.decorator": "#66a4b1",
    "method.decorator": "#66a4b1",
    "class.decorator": "#66a4b1",
    "function.decorator:python": "#66a4b1",
    "class.decorator:python": "#66a4b1"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#c1c8cf"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#c1c8cf"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#b8846f"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#83cad9"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d79073"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#799bbd"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#96ddeb"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#9aa0d4"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#d38089"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7a0bd"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#6ab9c8"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#d38089"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#aaf0ff"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#799bbd"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7a0bd"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#90acca"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#799bbd"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff0b00"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#799bbd"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7a0bd"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7a0bd"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#cab2d0"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#eca284"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#799bbd"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#83cad9"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#83cad9"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7a0bd"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#eca284"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#799bbd"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#eca284"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#83cad9"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#83cad9"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#799bbd"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#b7a0bd"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#588088"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#d38089"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#e5939c"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#d79073"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#c1c8cf"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#eca284"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#83cad9"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#588088"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#d79073"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#83cad9"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#eca284"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffb496"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#d79073"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#eca284"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#dc322f"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b7a0bd"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#83cad9"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#799bbd"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#ffa1ab"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#eca284"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#eca284"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#acb2e6"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#d38089"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#e2c0eb"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#66a4b1"
      }
    }
  ]
}
