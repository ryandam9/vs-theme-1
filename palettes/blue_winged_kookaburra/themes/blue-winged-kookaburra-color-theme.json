{
  "$schema": "vscode://schemas/color-theme",
  "name": "Blue-winged Kookaburra",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#1d303e",
    "list.activeSelectionBackground": "#2d5269",
    "quickInputList.focusBackground": "#2d5269",
    "list.inactiveSelectionBackground": "#2a4050",
    "list.hoverBackground": "#213442",
    "list.highlightForeground": "#d28a5f",
    "button.background": "#24445a",
    "editor.background": "#101922",
    "editor.foreground": "#d4d8e3",
    "editor.selectionBackground": "#205a7a80",
    "minimap.selectionHighlight": "#205a7a80",
    "editor.selectionHighlightBackground": "#1b486380",
    "editor.lineHighlightBackground": "#22313e",
    "editorLineNumber.activeForeground": "#839099",
    "editor.wordHighlightBackground": "#233f6780",
    "editor.wordHighlightStrongBackground": "#315b8880",
    "editorCursor.foreground": "#c45829",
    "editorWhitespace.foreground": "#354b58",
    "editorIndentGuide.background1": "#354b58",
    "editorIndentGuide.activeBackground1": "#536d7b",
    "editorGroupHeader.tabsBackground": "#16222d",
    "tab.inactiveBackground": "#1b2a36",
    "tab.border": "#22313e",
    "tab.inactiveForeground": "#d4d8e3",
    "tab.lastPinnedBorder": "#182936",
    "peekView.border": "#0b7595",
    "panelTitle.activeForeground": "#f3f5f7",
    "statusBar.background": "#182936",
    "statusBar.debuggingBackground": "#182936",
    "statusBar.noFolderBackground": "#182936",
    "titleBar.activeBackground": "#182936",
    "statusBarItem.remoteBackground": "#0b7595",
    "ports.iconRunningProcessForeground": "#c2cbd0",
    "activityBar.background": "#14232e",
    "activityBar.foreground": "#f3f5f7",
    "activityBarBadge.background": "#0b7595",
    "sideBar.background": "#141f2a",
    "sideBarSectionHeader.background": "#182936",
    "menu.background": "#141f2a",
    "menu.foreground": "#c2cbd0",
    "pickerGroup.foreground": "#a5afb6",
    "inputOption.activeBorder": "#0b7595",
    "focusBorder": "#0b7595",
    "agentsPanel.border": "#22313e",
    "agentsChatInput.border": "#22313e",
    "agentsChatInput.focusBorder": "#0b7595",
    "agentsNewSessionButton.border": "#22313e",
    "terminal.ansiBlack": "#101922",
    "terminal.ansiRed": "#c96468",
    "terminal.ansiGreen": "#8ead78",
    "terminal.ansiYellow": "#c8a667",
    "terminal.ansiBlue": "#5c87b9",
    "terminal.ansiMagenta": "#9c86b1",
    "terminal.ansiCyan": "#5da9ba",
    "terminal.ansiWhite": "#d4d8e3",
    "terminal.ansiBrightBlack": "#556975",
    "terminal.ansiBrightRed": "#e27b7e",
    "terminal.ansiBrightGreen": "#a9c78a",
    "terminal.ansiBrightYellow": "#e0c07b",
    "terminal.ansiBrightBlue": "#78a8d3",
    "terminal.ansiBrightMagenta": "#b8a6c0",
    "terminal.ansiBrightCyan": "#78c5d4",
    "terminal.ansiBrightWhite": "#f2f4f5",
    "terminal.inactiveSelectionBackground": "#205a7a40",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#b5a2af",
    "type": "#6fbece",
    "class": "#6fbece",
    "enum": "#6fbece",
    "interface": "#6fbece",
    "struct": "#6fbece",
    "typeParameter": "#79c5d4",
    "parameter": "#7fa8c4",
    "variable": "#d4d8e3",
    "variable.readonly": "#aab0d5",
    "variable.defaultLibrary": "#d67570",
    "property": "#b5a2af",
    "property.readonly": "#aab0d5",
    "enumMember": "#aab0d5",
    "event": "#b5a2af",
    "function": "#8dd7e6",
    "function.defaultLibrary": "#b5a2af",
    "method": "#8dd7e6",
    "method.defaultLibrary": "#b5a2af",
    "macro": "#d28a5f",
    "label": "#e0b38c",
    "decorator": "#65a9b8",
    "selfParameter": "#d99b76",
    "builtinConstant": "#79c5d4",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#79c5d4",
    "variable.readonly:go": "#aab0d5",
    "selfParameter:python": "#d99b76",
    "clsParameter:python": "#d99b76",
    "magicFunction:python": "#b5a2af",
    "builtinConstant:python": "#79c5d4",
    "module:python": "#b5a2af",
    "variable.defaultLibrary:typescript": "#d38c86",
    "variable.defaultLibrary:javascript": "#d38c86",
    "lifetime:rust": "#d28a5f",
    "builtinType:rust": "#79c5d4",
    "decorator:python": "#65a9b8",
    "function.decorator": "#65a9b8",
    "method.decorator": "#65a9b8",
    "class.decorator": "#65a9b8",
    "function.decorator:python": "#65a9b8",
    "class.decorator:python": "#65a9b8"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#d4d8e3"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#d4d8e3"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#8f9496"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#d6a675"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d28a5f"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#79c5d4"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#aab0d5"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#d67570"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#b5a2af"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#6fbece"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#d67570"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#8dd7e6"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#b5a2af"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#8fb5d2"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#b5a2af"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#b5a2af"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#afc6da"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#d6a675"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d6a675"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#b5a2af"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#d6a675"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#d6a675"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#b5a2af"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#99a3a6"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#d67570"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#d38c86"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#d28a5f"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#d4d8e3"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#d6a675"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#99a3a6"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#d28a5f"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#d6a675"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#e0b38c"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#d28a5f"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e0eddd"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#dc322f"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#b5a2af"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#d6a675"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#7fa8c4"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#d99aa8"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#d9b38c"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#b8a6c0"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796e6"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#cd9731"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f44747"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#b267e6"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#d67570"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#d99b76"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#65a9b8"
      }
    }
  ]
}
