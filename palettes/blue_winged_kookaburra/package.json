{
  "name": "blue-winged-kookaburra",
  "displayName": "Blue-winged Kookaburra",
  "description": "A bird-inspired dark VS Code theme with deep navy surfaces, Blue-winged Kookaburra feather blues, warm cream text and restrained rufous accents.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "kookaburra",
    "bird",
    "blue",
    "dark",
    "semantic highlighting",
    "theme"
  ],
  "galleryBanner": {
    "color": "#081521",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Blue-winged Kookaburra",
        "label": "Blue-winged Kookaburra",
        "uiTheme": "vs-dark",
        "path": "./themes/blue-winged-kookaburra-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js blue_winged_kookaburra",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && code --install-extension blue-winged-kookaburra-1.0.0.vsix --force"
  }
}
