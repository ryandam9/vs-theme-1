{
  "$schema": "vscode://schemas/color-theme",
  "name": "Plains-wanderer",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "dropdown.background": "#d6cfca",
    "list.activeSelectionBackground": "#c0bab5",
    "quickInputList.focusBackground": "#c0bab5",
    "list.inactiveSelectionBackground": "#d8d2cd",
    "list.hoverBackground": "#e0dad4",
    "list.highlightForeground": "#4a2800",
    "button.background": "#d3ccc7",
    "editor.background": "#fff9f3",
    "editor.foreground": "#504c48",
    "editor.selectionBackground": "#a2c4e180",
    "minimap.selectionHighlight": "#a2c4e180",
    "editor.selectionHighlightBackground": "#adcfec80",
    "editor.lineHighlightBackground": "#f0eae4",
    "editorLineNumber.activeForeground": "#898581",
    "editor.wordHighlightBackground": "#d1c5ff80",
    "editor.wordHighlightStrongBackground": "#bba9f980",
    "editorCursor.foreground": "#693a00",
    "editorWhitespace.foreground": "#d2d9a8",
    "editorIndentGuide.background1": "#d2d9a8",
    "editorIndentGuide.activeBackground1": "#bbc292",
    "editorGroupHeader.tabsBackground": "#f7f0ea",
    "tab.inactiveBackground": "#e3ddd7",
    "tab.border": "#f0eae4",
    "tab.inactiveForeground": "#423e3b",
    "tab.lastPinnedBorder": "#d7d1cb",
    "peekView.border": "#3074a7",
    "panelTitle.activeForeground": "#201c19",
    "statusBar.background": "#d7d1cb",
    "statusBar.debuggingBackground": "#d7d1cb",
    "statusBar.noFolderBackground": "#d7d1cb",
    "titleBar.activeBackground": "#d7d1cb",
    "statusBarItem.remoteBackground": "#3074a7",
    "ports.iconRunningProcessForeground": "#4e4a46",
    "activityBar.background": "#ece5e0",
    "activityBar.foreground": "#201c19",
    "activityBarBadge.background": "#3074a7",
    "sideBar.background": "#f7f1eb",
    "sideBarSectionHeader.background": "#d7d1cb",
    "menu.background": "#f7f1eb",
    "menu.foreground": "#4e4a46",
    "pickerGroup.foreground": "#6a6663",
    "inputOption.activeBorder": "#3074a7",
    "focusBorder": "#3074a7",
    "agentsPanel.border": "#f0eae4",
    "agentsChatInput.border": "#f0eae4",
    "agentsChatInput.focusBorder": "#3074a7",
    "agentsNewSessionButton.border": "#f0eae4",
    "terminal.ansiBlack": "#fff9f3",
    "terminal.ansiRed": "#b30c55",
    "terminal.ansiGreen": "#283d00",
    "terminal.ansiYellow": "#2e2f00",
    "terminal.ansiBlue": "#41478e",
    "terminal.ansiMagenta": "#5c3c94",
    "terminal.ansiCyan": "#004047",
    "terminal.ansiWhite": "#22221e",
    "terminal.ansiBrightBlack": "#c7c1bb",
    "terminal.ansiBrightRed": "#870034",
    "terminal.ansiBrightGreen": "#182700",
    "terminal.ansiBrightYellow": "#232400",
    "terminal.ansiBrightBlue": "#28227f",
    "terminal.ansiBrightMagenta": "#453374",
    "terminal.ansiBrightCyan": "#00272d",
    "terminal.ansiBrightWhite": "#22221e",
    "terminal.inactiveSelectionBackground": "#a2c4e140",
    "agentsBottomPanel.border": "#00000000",
    "agentsCard.border": "#00000000",
    "surface.border": "#00000000"
  },
  "semanticTokenColors": {
    "namespace": "#6a3958",
    "type": "#2d4903",
    "class": "#2d4903",
    "enum": "#2d4903",
    "interface": "#2d4903",
    "struct": "#2d4903",
    "typeParameter": "#194d21",
    "parameter": "#32638a",
    "variable": "#504c48",
    "variable.readonly": "#554386",
    "variable.defaultLibrary": "#833741",
    "property": "#6a3958",
    "property.readonly": "#554386",
    "enumMember": "#554386",
    "event": "#6a3958",
    "function": "#003637",
    "function.defaultLibrary": "#6a3958",
    "method": "#003637",
    "method.defaultLibrary": "#6a3958",
    "macro": "#7f4e19",
    "label": "#282100",
    "decorator": "#005657",
    "selfParameter": "#4d133b",
    "builtinConstant": "#194d21",
    "*.declaration": {
      "fontStyle": "bold"
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.static": {
      "fontStyle": "italic"
    },
    "type.defaultLibrary:go": "#194d21",
    "variable.readonly:go": "#554386",
    "selfParameter:python": "#4d133b",
    "clsParameter:python": "#4d133b",
    "magicFunction:python": "#6a3958",
    "builtinConstant:python": "#194d21",
    "module:python": "#6a3958",
    "variable.defaultLibrary:typescript": "#944951",
    "variable.defaultLibrary:javascript": "#944951",
    "lifetime:rust": "#7f4e19",
    "builtinType:rust": "#194d21",
    "decorator:python": "#005657",
    "function.decorator": "#005657",
    "method.decorator": "#005657",
    "class.decorator": "#005657",
    "function.decorator:python": "#005657",
    "class.decorator:python": "#005657"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#504c48"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#504c48"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "fontStyle": "",
        "foreground": "#966d00"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "fontStyle": "",
        "foreground": "#213800"
      }
    },
    {
      "name": "String Embedded Source",
      "scope": "string source",
      "settings": {
        "fontStyle": "",
        "foreground": "#7f4e19"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "fontStyle": "",
        "foreground": "#32638a"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "fontStyle": "",
        "foreground": "#194d21"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "fontStyle": "",
        "foreground": "#554386"
      }
    },
    {
      "name": "Support",
      "scope": "support",
      "settings": {
        "fontStyle": "",
        "foreground": "#833741"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#6a3958"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.class, entity.name.type, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "",
        "foreground": "#2d4903"
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#833741"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#003637"
      }
    },
    {
      "name": "Function argument",
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "",
        "foreground": "#32638a"
      }
    },
    {
      "name": "Library function",
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#6a3958"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "fontStyle": "",
        "foreground": "#295374"
      }
    },
    {
      "name": "Class Variable",
      "scope": "variable.other, variable.js, punctuation.separator.variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#32638a"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#ff0b00"
      }
    },
    {
      "name": "Normal Variable",
      "scope": "variable.other.php, variable.other.normal",
      "settings": {
        "fontStyle": "",
        "foreground": "#32638a"
      }
    },
    {
      "name": "Function Object",
      "scope": "meta.function-call.object",
      "settings": {
        "fontStyle": "",
        "foreground": "#6a3958"
      }
    },
    {
      "name": "Function Call Variable",
      "scope": "variable.other.property",
      "settings": {
        "fontStyle": "",
        "foreground": "#6a3958"
      }
    },
    {
      "name": "Keyword Control / Special",
      "scope": [
        "keyword.control",
        "keyword.operator.new.cpp",
        "keyword.operator.delete.cpp",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#582a48"
      }
    },
    {
      "name": "Tag",
      "scope": "meta.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#382f00"
      }
    },
    {
      "name": "Tag Name",
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#32638a"
      }
    },
    {
      "name": "Doctype",
      "scope": "meta.doctype, meta.tag.sgml-declaration.doctype, meta.tag.sgml.doctype",
      "settings": {
        "fontStyle": "",
        "foreground": "#213800"
      }
    },
    {
      "name": "Tag Inline Source",
      "scope": "meta.tag.inline source, text.html.php.source",
      "settings": {
        "fontStyle": "",
        "foreground": "#213800"
      }
    },
    {
      "name": "Tag Other",
      "scope": "meta.tag.other, entity.name.tag.style, entity.name.tag.script, meta.tag.block.script, source.js.embedded punctuation.definition.tag.html, source.css.embedded punctuation.definition.tag.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#6a3958"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": "entity.other.attribute-name, meta.tag punctuation.definition.string",
      "settings": {
        "fontStyle": "",
        "foreground": "#382f00"
      }
    },
    {
      "name": "Tag Value",
      "scope": "meta.tag string -source -punctuation, text source text meta.tag string -punctuation",
      "settings": {
        "fontStyle": "",
        "foreground": "#32638a"
      }
    },
    {
      "name": "Meta Brace",
      "scope": "punctuation.section.embedded -(source string source punctuation.section.embedded), meta.brace.erb.html",
      "settings": {
        "fontStyle": "",
        "foreground": "#382f00"
      }
    },
    {
      "name": "HTML ID",
      "scope": "meta.toc-list.id",
      "settings": {
        "foreground": "#213800"
      }
    },
    {
      "name": "HTML String",
      "scope": "string.quoted.double.html, punctuation.definition.string.begin.html, punctuation.definition.string.end.html, punctuation.definition.string.end.html source, string.quoted.double.html source",
      "settings": {
        "fontStyle": "",
        "foreground": "#213800"
      }
    },
    {
      "name": "HTML Tags",
      "scope": "punctuation.definition.tag.html, punctuation.definition.tag.begin, punctuation.definition.tag.end",
      "settings": {
        "fontStyle": "",
        "foreground": "#32638a"
      }
    },
    {
      "name": "CSS ID",
      "scope": "meta.selector entity.other.attribute-name.id",
      "settings": {
        "fontStyle": "",
        "foreground": "#6a3958"
      }
    },
    {
      "name": "CSS Property Name",
      "scope": "source.css support.type.property-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#688b6a"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "meta.property-group support.constant.property-value, meta.property-value support.constant.property-value",
      "settings": {
        "fontStyle": "",
        "foreground": "#833741"
      }
    },
    {
      "name": "JavaScript Variable",
      "scope": "variable.language.js",
      "settings": {
        "foreground": "#944951"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.coffee"
      ],
      "settings": {
        "foreground": "#7f4e19"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#504c48"
      }
    },
    {
      "name": "PHP Function Call",
      "scope": "meta.function-call.object.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#382f00"
      }
    },
    {
      "name": "PHP Single Quote HMTL Fix",
      "scope": "punctuation.definition.string.end.php, punctuation.definition.string.begin.php",
      "settings": {
        "foreground": "#213800"
      }
    },
    {
      "name": "PHP Parenthesis HMTL Fix",
      "scope": "source.php.embedded.line.html",
      "settings": {
        "foreground": "#688b6a"
      }
    },
    {
      "name": "PHP Punctuation Embedded",
      "scope": "punctuation.section.embedded.begin.php, punctuation.section.embedded.end.php",
      "settings": {
        "fontStyle": "",
        "foreground": "#7f4e19"
      }
    },
    {
      "name": "Ruby Symbol",
      "scope": "constant.other.symbol.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#213800"
      }
    },
    {
      "name": "Ruby Variable",
      "scope": "variable.language.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#382f00"
      }
    },
    {
      "name": "Ruby Special Method",
      "scope": "keyword.other.special-method.ruby",
      "settings": {
        "fontStyle": "",
        "foreground": "#282100"
      }
    },
    {
      "name": "Ruby Embedded Source",
      "scope": [
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#7f4e19"
      }
    },
    {
      "name": "SQL",
      "scope": "keyword.other.DML.sql",
      "settings": {
        "fontStyle": "",
        "foreground": "#382f00"
      }
    },
    {
      "name": "diff: header",
      "scope": "meta.diff, meta.diff.header",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7b8778"
      }
    },
    {
      "name": "diff: deleted",
      "scope": "markup.deleted",
      "settings": {
        "fontStyle": "",
        "foreground": "#dc322f"
      }
    },
    {
      "name": "diff: changed",
      "scope": "markup.changed",
      "settings": {
        "fontStyle": "",
        "foreground": "#cb4b16"
      }
    },
    {
      "name": "diff: inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#219186"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6a3958"
      }
    },
    {
      "name": "Markup Lists",
      "scope": "markup.list",
      "settings": {
        "foreground": "#213800"
      }
    },
    {
      "name": "Markup Styling",
      "scope": "markup.bold, markup.italic",
      "settings": {
        "foreground": "#32638a"
      }
    },
    {
      "name": "Markup Inline",
      "scope": "markup.inline.raw",
      "settings": {
        "fontStyle": "",
        "foreground": "#9e4265"
      }
    },
    {
      "name": "Markup Headings",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#382f00"
      }
    },
    {
      "name": "Markup Setext Header",
      "scope": "markup.heading.setext",
      "settings": {
        "fontStyle": "",
        "foreground": "#382f00"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "markup.heading.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": "markup.quote.markdown",
      "settings": {
        "fontStyle": "italic",
        "foreground": ""
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.markdown",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link Title/Description",
      "scope": "string.other.link.title.markdown,string.other.link.description.markdown",
      "settings": {
        "foreground": "#453374"
      }
    },
    {
      "name": "Markdown Underline Link/Image",
      "scope": "markup.underline.link.markdown,markup.underline.link.image.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown Emphasis",
      "scope": "markup.italic.markdown",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Punctuation Definition Link",
      "scope": "markup.list.unnumbered.markdown, markup.list.numbered.markdown",
      "settings": {
        "foreground": ""
      }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": ""
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#5583d2"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#ad7a00"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#f04243"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#aa5fde"
      }
    },
    {
      "name": "this.self",
      "scope": "variable.language",
      "settings": {
        "foreground": "#833741"
      }
    },
    {
      "name": "Python self / cls",
      "scope": "variable.parameter.function.language.special.self.python, variable.parameter.function.language.python",
      "settings": {
        "foreground": "#4d133b"
      }
    },
    {
      "name": "Python decorator",
      "scope": "entity.name.function.decorator.python, punctuation.definition.decorator.python, meta.function.decorator.python entity.name.function.python",
      "settings": {
        "foreground": "#005657"
      }
    }
  ]
}
