{
  "name": "plains-wanderer",
  "displayName": "Plains-wanderer",
  "description": "A personal fork of Monokai Dimmed with explicit semantic token colors, so Go, Python, TypeScript and Rust all look the same. Recoloured from the Plains-wanderer palette.",
  "version": "1.0.0",
  "publisher": "ravi",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "monokai",
    "light",
    "semantic highlighting",
    "theme",
    "Plains-wanderer"
  ],
  "galleryBanner": {
    "color": "#fff9f3",
    "theme": "light"
  },
  "contributes": {
    "themes": [
      {
        "id": "Plains-wanderer",
        "label": "Plains-wanderer",
        "uiTheme": "vs",
        "path": "./themes/plains-wanderer-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "cd ../.. && node build.js plains_wanderer",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-local": "npm run package && node ../../scripts/install-local.js"
  }
}
